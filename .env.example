# =============================================================
# Cliny Agenda — Environment Variables
# =============================================================
#
# Copy this file to `.env.local` for local development.
# In Vercel, set the SAME variables in the project's
# Environment Variables panel (use "Sensitive" for any secret).
#
# IMPORTANT:
#   - Variables prefixed with VITE_  are EXPOSED to the browser
#     (they are bundled into the SPA at build time).
#   - Variables WITHOUT the VITE_ prefix are server-only and
#     can be marked as "Sensitive" in Vercel.
#

# -------- Supabase (Auth & Database) --------
# Browser-exposed (Frontend Auth)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only (Admin Access)
# Service Role Key is used in /api/**/* to bypass RLS.
# NEVER expose this in the frontend (no VITE_ prefix).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Porta local do servidor Express (default 3001). O Vite dev faz proxy de /api → :API_PORT.
API_PORT=3001

# -------- Gemini (AI agent) --------
GEMINI_API_KEY=""

# -------- Evolution API (WhatsApp) --------
EVOLUTION_API_URL=""
EVOLUTION_GLOBAL_API_KEY=""

# Shared secret used to authenticate inbound webhook calls from
# the Evolution API. Required in production.
EVOLUTION_WEBHOOK_SECRET=""

# Public URL of this deployment.
PUBLIC_URL=""
